generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  vendor       Vendor?
  orders       Order[]
  cartItems    CartItem[]
}

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  description String       @default("")
  status      VendorStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  products    Product[]
  orderItems  OrderItem[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  title       String
  slug        String      @unique
  description String
  price       Int // stored in cents to avoid floating point issues
  stock       Int         @default(0)
  images      String[]
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([price])
  @@index([createdAt])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  total           Int // cents
  stripeSessionId String?     @unique
  shippingAddress String
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  title           String // snapshot of the product title at purchase time
  image           String   @default("")
  quantity        Int
  priceAtPurchase Int // cents

  @@index([orderId])
  @@index([vendorId])
  @@index([productId])
}
